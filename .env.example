# Application
APP_ENV=development
SECRET_KEY=change-this-before-deployment
HOST=127.0.0.1
PORT=5000
DEBUG=true

# Local mode: uses CSV files and scikit-learn models in the current environment.
DATA_MODE=local
DATASET_FILE_PATH=data/raw/CVD_Standard_DWD_refined.csv
POPULATION_DATASET_PATH=data/raw/chengdu_resident_health_simulated.csv
MODEL_OUTPUT_DIR=data/models
MODEL_MANIFEST_PATH=data/models/active_models.json
TRAINING_RESULTS_PATH=docs/training_results.md

# Phase 2 local task and upload storage.
DATABASE_TYPE=sqlite
DATABASE_PATH=data/localstorage/app.db
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-this
MYSQL_DATABASE=cardiospark
UPLOAD_ROOT=data/localstorage/uploads
LOCAL_RESULT_ROOT=data/localstorage/results
UPLOAD_MAX_FILE_SIZE=536870912
UPLOAD_CHUNK_SIZE=8388608
TASK_WORKERS=2
PRIVACY_MIN_GROUP_SIZE=5
KNOWLEDGE_BASE_PATH=resources/knowledge/intervention_rules.json
MAP_ASSET_DIR=static/geo

# HDFS mode: the current environment runs Spark; VMware/WSL2 provides HDFS.
# DATA_MODE=hdfs
HDFS_NAMENODE_URI=hdfs://localhost:9000
HDFS_WEB_URL=http://localhost:9870
# Set this when WebHDFS redirects to a host name not reachable from the current environment.
# HDFS_DATANODE_HOST=<reachable-datanode-host>
# Replace your_linux_username with the Linux account used by Hadoop.
HDFS_USER=your_linux_username
HDFS_RAW_PATH=/user/your_linux_username/cardiospark/raw
HDFS_INPUT_PATH=/user/your_linux_username/cardiospark/raw/chengdu_resident_health_simulated.csv
HDFS_STAGING_PATH=/user/your_linux_username/cardiospark/staging
HDFS_FEATURE_PATH=/user/your_linux_username/cardiospark/feature
HDFS_UPLOAD_ROOT=/user/your_linux_username/cardiospark/raw/_uploads
HDFS_RESULT_ROOT=/user/your_linux_username/cardiospark/feature/ads
SPARK_SUBMIT_BIN=spark-submit

# Phase-two model scoring uses the Pandas UDF implementation.
SPARK_SCORE_ENGINE=pandas

# Model training
RANDOM_STATE=20260714
TRAIN_TEST_SPLIT_RATIO=0.2
XGBOOST_TREES=850
XGBOOST_MAX_DEPTH=3
XGBOOST_LEARNING_RATE=0.025
XGBOOST_MIN_CHILD_WEIGHT=3
XGBOOST_SUBSAMPLE=0.95
XGBOOST_COLSAMPLE_BYTREE=1.0
XGBOOST_GAMMA=0.0
XGBOOST_REG_ALPHA=0.0
XGBOOST_REG_LAMBDA=2.0
STROKE_MIN_RECALL=0.70
